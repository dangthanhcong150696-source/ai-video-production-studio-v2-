{
  "name": "ai-video-production-studio",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.mjs\" \"vite --host 0.0.0.0\"",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:v3.2": "node --test --test-concurrency=1 tests/v3-2-storage.test.mjs tests/v3-2-qc.test.mjs",
    "test:browser": "playwright test",
    "test:storyboard": "node --test tests/storyboard.test.mjs",
    "test:storyboard:browser": "playwright test tests/browser/storyboard.spec.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.0"
  }
}
